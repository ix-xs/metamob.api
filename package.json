{
  "name": "@ix-xs/metamob.api",
  "version": "5.0.2",
  "description": "Le client complet de l'API Metamob pour JavaScript et TypeScript : tous les points d'accès, typés, avec les monstres, zones et serveurs appelés par leur nom en français, anglais ou espagnol. Pagination paresseuse, limiteur de requêtes intégré, nouvelles tentatives et cache. Aucune dépendance.",
  "keywords": [
    "metamob",
    "dofus",
    "dofus-retro",
    "dofus-touch",
    "archimonstre",
    "archmonster",
    "ocre",
    "dokille",
    "kralamoure",
    "ankama",
    "api-client",
    "sdk",
    "typescript",
    "discord-bot",
    "rate-limit",
    "pagination",
    "zero-dependency",
    "esm"
  ],
  "author": "ix-xs.dev <contact@ix-xs.dev>",
  "license": "MIT",
  "homepage": "https://ix-xs.github.io/metamob.api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ix-xs/metamob.api.git"
  },
  "bugs": {
    "url": "https://github.com/ix-xs/metamob.api/issues"
  },
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "README.es.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "data:update": "node scripts/update-data.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.test.json",
    "lint:prose": "node scripts/lint-prose.mjs",
    "attw": "attw --pack .",
    "smoke": "node test/smoke/cjs.cjs && node test/smoke/esm.mjs",
    "bench": "node scripts/bench.mjs",
    "live": "tsx test/live/run.mts",
    "check": "npm run generate -- --check && npm run lint:prose && npm run typecheck && npm run test:types && npm run build && npm test && npm run smoke",
    "docs": "npm --prefix docs install && npm --prefix docs run dev",
    "docs:build": "npm --prefix docs install && npm --prefix docs run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ix-xs/node-comfort": "^2.1.0",
    "@types/node": "^22.10.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
