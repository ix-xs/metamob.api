# Used by `npm run data:update` and `npm run live`, which talk to the real API.
# Copy to .env and fill in. Never commit .env.

# Your Metamob API key: metamob.fr > Settings > API key.
METAMOB_API_KEY=

# Optional, for `npm run live`: the slug of one of your own quests. The write
# steps set one monster to a quantity and put it back.
METAMOB_QUEST_SLUG=
