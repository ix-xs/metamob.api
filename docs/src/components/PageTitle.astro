---
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type Entry = StarlightRouteData["sidebar"][number];

function trail(entries: Entry[], path: string[] = []): string[] | undefined {
  for (const entry of entries) {
    if (entry.type === "link") {
      if (entry.isCurrent) return path;
    } else {
      const found = trail(entry.entries, [...path, entry.label]);
      if (found) return found;
    }
  }
  return undefined;
}

const { entry, sidebar } = Astro.locals.starlightRoute;
const groups = trail(sidebar) ?? [];
// A page of the reference sets its own lead, and the pages of the guide's path
// open with their own first paragraph: the description stays for search engines.
const symbolPage = /\/reference\/[^/]+\/$/.test(Astro.url.pathname);
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, "").length).replace(/^\/(en|es)(?=\/|$)/, "");
const guidePath = path === "/" || path === "" || path.startsWith("/start/") || path.startsWith("/script/");
const lead = symbolPage || guidePath ? undefined : entry.data.description;
---
{groups.length > 0 && <p class="at-eyebrow">{groups.join(" / ")}</p>}
<h1 id="_top" class="at-title">{entry.data.title}</h1>
{lead && <p class="at-lead">{lead}</p>}
